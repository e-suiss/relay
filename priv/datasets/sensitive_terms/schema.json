{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sensitive_terms",
  "description": "Terms whose presence in a template's fixed text or variable names makes the tenant confirm the sensitivity class explicitly before publication. Matching lowercases with the locale's rules, folds accents and matches a term as the prefix of a word, so a Turkish stem matches its suffixed forms. A match never blocks publication by itself. A term is never removed: it is marked deprecated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "terms"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "locale",
          "category"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-zçğıöşü]+( [a-zçğıöşü]+)*$"
          },
          "locale": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "health",
              "finance",
              "identity_legal",
              "special_category"
            ]
          },
          "qualifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "deprecated": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
