{
  "name": "@esuiss/relay-site",
  "version": "0.0.0",
  "private": true,
  "description": "The Relay documentation site.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "generate": "node scripts/generate-reference.ts",
    "dev": "npm run generate && vitepress dev",
    "build": "npm run generate && vitepress build",
    "preview": "vitepress preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:content": "node scripts/check-content.ts",
    "check:links": "node scripts/check-links.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "a11y": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@esuiss/relay": "file:../sdks/typescript",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitepress": "1.6.4",
    "vue": "3.5.45",
    "yaml": "2.9.1"
  }
}
