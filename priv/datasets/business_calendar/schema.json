{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "business_calendar",
  "description": "Business days by country (PC-31, PC-60). For each country: the full-day public holidays, the half days and the first and last day the list covers. A Saturday, a Sunday and a full-day holiday are not business days; a half day is a business day. Past `coverage_end` only weekends are known.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_ref", "countries"],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "countries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coverage_start", "coverage_end", "holidays", "half_days"],
        "properties": {
          "coverage_start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "coverage_end": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "holidays": {
            "type": "array",
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          "half_days": {
            "type": "array",
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      }
    }
  }
}
