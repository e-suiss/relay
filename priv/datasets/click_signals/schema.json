{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "click_signals",
  "description": "The signals that classify an e-mail click as human or likely bot and an e-mail open as a machine open (CH-43, DS-30, DS-32, DS-52). Any signal that holds makes the click likely_bot; the deciding signal is kept on the event. timing: a click less than after_send_ms after the send or the provider's delivery. burst: at least distinct_links distinct links of one message clicked within window_ms. request: a request with one of methods, or without one of required_headers (lower case names). ip_blocks: published security scanner and mail gateway blocks, each row with its operator, source link and compile date. user_agents: User-Agent substrings of scanners and automation clients, compared without case. open_proxies: User-Agent substrings of image proxies that fetch an open pixel on the reader's behalf.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "timing",
    "burst",
    "request",
    "ip_blocks",
    "user_agents",
    "open_proxies"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_send_ms"
      ],
      "properties": {
        "after_send_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "burst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ms",
        "distinct_links"
      ],
      "properties": {
        "window_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "distinct_links": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods",
        "required_headers"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,16}$"
          }
        },
        "required_headers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          }
        }
      }
    },
    "ip_blocks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operator",
          "name",
          "source",
          "compiled_at",
          "cidrs"
        ],
        "properties": {
          "operator": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 1024
          },
          "compiled_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "cidrs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f:.]+/[0-9]{1,3}$",
              "maxLength": 64
            }
          }
        }
      }
    },
    "user_agents": {
      "$ref": "#/$defs/patterns"
    },
    "open_proxies": {
      "$ref": "#/$defs/patterns"
    }
  },
  "$defs": {
    "patterns": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern",
          "source"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
