{
  "track": "agent-message",
  "version": "1",
  "operation": "untrusted_content",
  "rule": [
    "AG-40",
    "AG-68"
  ],
  "description": "The untrusted content mark and the normalisation of untrusted text. cases: normalising input of the given format (html or plain) gives output; rule names the step of the normalisation the case fixes: 2a HTML stripping, 2b Unicode NFC, 2c removal of invisible characters. The steps run in that order. marks: text between the boundary marks of the value nonce is marked; every <<<relay: inside the text is written <<<relay%3A. Strings are JSON strings; characters outside ASCII are written as \\u escapes.",
  "cases": [
    {
      "name": "html-tags-dropped-text-kept",
      "rule": "2a",
      "format": "html",
      "input": "<p>Hello <b>world</b></p>",
      "output": "Hello world"
    },
