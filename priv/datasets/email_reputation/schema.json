{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_reputation",
  "description": "The e-mail reputation circuit and soft bounce parameters (CH-40, CH-41). Rates are in basis points: the bounce rate is bounces over sent mail, the complaint rate complaints over mail delivered to the inbox (CH-37). The window is sliding and split into equal buckets. A stopped circuit never closes by itself. No stop decision is made while fewer than `min_volume` mails were sent in the window (none when absent). A soft bounce counts toward a timed suppression once `count` soft bounces fall inside `window_ms`; the suppression lasts `suppress_ms`, and without it no timed suppression is written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "reputation",
    "soft_bounce"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "reputation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ms",
        "buckets",
        "warn_bounce_bp",
        "warn_complaint_bp",
        "stop_bounce_bp",
        "stop_complaint_bp"
      ],
      "properties": {
        "window_ms": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 604800000
        },
        "buckets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "warn_bounce_bp": {
          "$ref": "#/$defs/bp"
        },
        "warn_complaint_bp": {
          "$ref": "#/$defs/bp"
        },
        "stop_bounce_bp": {
          "$ref": "#/$defs/bp"
        },
        "stop_complaint_bp": {
          "$ref": "#/$defs/bp"
        },
        "min_volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "soft_bounce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ms",
        "count"
      ],
      "properties": {
        "window_ms": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 2592000000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "suppress_ms": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 31536000000
        }
      }
    }
  },
  "$defs": {
    "bp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
