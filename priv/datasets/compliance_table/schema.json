{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compliance_table",
  "description": "The compliance table (PC-40): country, channel, message class, consent kind and legal recipient type give the consent a delivery needs and its obligations (footer, legal send window, revocation scope). A country row names a country, a region of the regions list or * for every country without a row of its own, where marketing needs explicit opt-in (PC-41). A row accepts the consent kinds it lists; none means no prior consent. Platform rows hold the rules of app stores and messaging platforms independent of the country (PC-54); a platform row and a country row apply together and the more restrictive one wins. Exceptions are rows, never flags (PC-42). A change of legal content is a new version (PC-44).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "review",
    "regions",
    "shared_calling_codes",
    "country_rows",
    "platform_rows"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "review": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "regions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "countries"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "countries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      }
    },
    "shared_calling_codes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "countries"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,2}$"
          },
          "countries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      }
    },
    "country_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "country",
          "channels",
          "classes",
          "recipient_types",
          "consent",
          "conditions",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
            "maxLength": 96
          },
          "country": {
            "type": "string",
            "pattern": "^([A-Z]{2}|\\*)$"
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "push",
                "web_push",
                "email",
                "sms",
                "voice",
                "whatsapp",
                "slack",
                "teams",
                "telegram",
                "discord",
                "in_app",
                "webhook"
              ]
            }
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "security",
                "action_required",
                "transactional",
                "operational",
                "social",
                "marketing",
                "system"
              ]
            }
          },
          "recipient_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "individual",
                "merchant"
              ]
            }
          },
          "consent": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "explicit_opt_in",
                "soft_opt_in",
                "legitimate_interest",
                "none"
              ]
            }
          },
          "iys": {
            "enum": [
              "approval",
              "rejection"
            ]
          },
          "legal_window": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "zones"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "to": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "zones": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+\\-]+)+$"
                }
              }
            }
          },
          "revocation_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "channels",
              "status"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "category",
                  "all_marketing",
                  "all_channel"
                ]
              },
              "channels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "push",
                    "web_push",
                    "email",
                    "sms",
                    "voice",
                    "whatsapp",
                    "slack",
                    "teams",
                    "telegram",
                    "discord",
                    "in_app",
                    "webhook"
                  ]
                }
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "footer": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "legal_name",
                "mersis_or_contact",
                "opt_out",
                "commercial_notice",
                "postal_address"
              ]
            }
          },
          "conditions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "platform_rows": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "platform",
          "channels",
          "classes",
          "consent",
          "default",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
            "maxLength": 96
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "platform": {
            "oneOf": [
              {
                "enum": [
                  "ios",
                  "android",
                  "web"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "push",
                "web_push",
                "email",
                "sms",
                "voice",
                "whatsapp",
                "slack",
                "teams",
                "telegram",
                "discord",
                "in_app",
                "webhook"
              ]
            }
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "security",
                "action_required",
                "transactional",
                "operational",
                "social",
                "marketing",
                "system"
              ]
            }
          },
          "consent": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "explicit_opt_in",
                "soft_opt_in",
                "legitimate_interest",
                "none"
              ]
            }
          },
          "default": {
            "enum": [
              "off",
              "tenant"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
