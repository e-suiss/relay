{
  "$defs": {
    "capability": {
      "additionalProperties": false,
      "properties": {
        "business_initiated": {
          "type": "boolean"
        },
        "collapse": {
          "type": "boolean"
        },
        "delivery_receipts": {
          "type": "boolean"
        },
        "inbound": {
          "type": "boolean"
        },
        "read_receipts": {
          "type": "boolean"
        },
        "recall": {
          "type": "boolean"
        },
        "ttl": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        }
      },
      "required": [
        "delivery_receipts",
        "read_receipts",
        "collapse",
        "ttl",
        "update",
        "recall",
        "business_initiated",
        "inbound"
      ],
      "type": "object"
    },
    "channel": {
      "enum": [
        "push",
        "web_push",
        "email",
        "sms",
        "voice",
        "whatsapp",
        "slack",
        "teams",
        "telegram",
        "discord",
        "in_app",
        "webhook"
      ]
    },
    "country": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    },
    "date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "event_code": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "after_delivered": {
          "enum": [
            "valid",
            "stale",
            "conflict"
          ]
        },
        "attempt_effect": {
          "enum": [
            "none",
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "decision_grade": {
          "enum": [
            "reliable",
            "unreliable"
          ]
        },
        "effect_kind": {
          "enum": [
            "evidence",
            "operational_signal",
            "side_effect"
          ]
        },
        "event_code": {
          "$ref": "#/$defs/event_code"
        },
        "projection_effect": {
          "enum": [
            "none",
            "raise_delivery",
            "set_failure",
            "flag_conflict"
          ]
        },
        "scope": {
          "enum": [
            "attempt",
            "delivery"
          ]
        },
        "sets_delivery": {
          "enum": [
            "none",
            "accepted",
            "delivered"
          ]
        },
        "sets_failure": {
          "enum": [
            "none",
            "skipped",
            "failed",
            "bounced",
            "expired",
            "cancelled"
          ]
        },
        "side_effect": {
          "enum": [
            "none",
            "deactivate_device",
            "add_suppression"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "channel",
        "event_code",
        "effect_kind",
        "sets_delivery",
        "sets_failure",
        "attempt_effect",
        "after_delivered",
        "projection_effect",
        "side_effect",
        "scope",
        "decision_grade",
        "source"
      ],
      "type": "object"
    },
    "failure_class": {
      "enum": [
        "transient",
        "permanent_target",
        "permanent_content",
        "policy",
        "quota",
        "auth",
        "sender_config",
        "unknown"
      ]
    },
    "limit": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "limit": {
          "minimum": 1,
          "type": "integer"
        },
        "per_ms": {
          "maximum": 86400000,
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "unit": {
          "enum": [
            "message",
            "segment",
            "recipient",
            "request",
            "session",
            "conversation"
          ]
        }
      },
      "required": [
        "channel",
        "unit",
        "limit",
        "per_ms",
        "source"
      ],
      "type": "object"
    },
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "$ref": "#/$defs/failure_class"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_code": {
          "$ref": "#/$defs/event_code"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "suppressed_success": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "class",
        "condition",
        "event_code",
        "suppressed_success",
        "source"
      ],
      "type": "object"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9_]{1,31}$",
      "type": "string"
    },
    "source": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "vector": {
      "additionalProperties": false,
      "properties": {
        "expect": {
          "additionalProperties": false,
          "properties": {
            "class": {
              "$ref": "#/$defs/failure_class"
            },
            "condition": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "event_code": {
              "$ref": "#/$defs/event_code"
            },
            "suppressed_success": {
              "type": "boolean"
            }
          },
          "required": [
            "class",
            "condition",
            "event_code",
            "suppressed_success"
          ],
          "type": "object"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "raw": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "retry_after_ms": {
              "anyOf": [
                {
                  "maximum": 86400000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "anyOf": [
                {
                  "maximum": 999,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "status",
            "retry_after_ms"
          ],
          "type": "object"
        },
        "response": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "raw",
        "expect"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The channel adapter declarations (CH-2, CH-71) and the channel delivery semantics (DS-12): per provider its capability flags, channel_event_evidence rows (DS-10), provider idempotency policy, failure class mapping with test vectors, price and limit data, data residency and inbound webhook verification. A provider whose declaration is incomplete stays registered but receives no traffic.",
  "properties": {
    "providers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "adapter_version": {
            "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$",
            "type": "string"
          },
          "capabilities": {
            "additionalProperties": {
              "$ref": "#/$defs/capability"
            },
            "propertyNames": {
              "$ref": "#/$defs/channel"
            },
            "type": "object"
          },
          "channels": {
            "items": {
              "$ref": "#/$defs/channel"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "compiled_at": {
            "$ref": "#/$defs/date"
          },
          "data_residency": {
            "additionalProperties": false,
            "properties": {
              "in_installation": {
                "type": "boolean"
              },
              "processing_countries": {
                "items": {
                  "$ref": "#/$defs/country"
                },
                "type": "array",
                "uniqueItems": true
              },
              "scc_notified_on": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "transfer_basis": {
                "enum": [
                  "none",
                  "adequacy",
                  "scc",
                  "explicit_consent",
                  "derogation"
                ]
              }
            },
            "required": [
              "in_installation",
              "processing_countries",
              "transfer_basis",
              "scc_notified_on",
              "source"
            ],
            "type": "object"
          },
          "deprecations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "api": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "source": {
                  "$ref": "#/$defs/source"
                },
                "sunset_on": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "api",
                "sunset_on",
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "errors": {
            "items": {
              "$ref": "#/$defs/mapping"
            },
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "type": "array"
          },
          "inbound_verification": {
            "additionalProperties": false,
            "properties": {
              "authenticity": {
                "enum": [
                  "verified",
                  "unverifiable"
                ]
              },
              "header": {
                "anyOf": [
                  {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "method": {
                "enum": [
                  "standard_webhooks",
                  "hmac_sha256",
                  "ed25519",
                  "ecdsa_p256",
                  "jwt",
                  "secret_token",
                  "basic_ip_allowlist",
                  "sns_signature",
                  "none"
                ]
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            },
            "required": [
              "method",
              "header",
              "authenticity",
              "source"
            ],
            "type": "object"
          },
          "limits": {
            "additionalProperties": false,
            "properties": {
              "account": {
                "items": {
                  "$ref": "#/$defs/limit"
                },
                "type": "array"
              },
              "recipient": {
                "items": {
                  "$ref": "#/$defs/limit"
                },
                "type": "array"
              },
              "sender": {
                "items": {
                  "$ref": "#/$defs/limit"
                },
                "type": "array"
              }
            },
            "required": [
              "account",
              "sender",
              "recipient"
            ],
            "type": "object"
          },
          "paid_channels": {
            "items": {
              "$ref": "#/$defs/channel"
            },
            "type": "array",
            "uniqueItems": true
          },
          "pricing": {
            "additionalProperties": false,
            "properties": {
              "currency": {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              "prices": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "category": {
                      "anyOf": [
                        {
                          "maxLength": 64,
                          "minLength": 1,
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "channel": {
                      "$ref": "#/$defs/channel"
                    },
                    "country": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/country"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "tier_from": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "unit_price_micros": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "channel",
                    "country",
                    "category",
                    "unit_price_micros",
                    "tier_from"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "units": {
                "additionalProperties": {
                  "enum": [
                    "message",
                    "segment",
                    "session",
                    "verification",
                    "answered_call",
                    "call_minute",
                    "none"
                  ]
                },
                "propertyNames": {
                  "$ref": "#/$defs/channel"
                },
                "type": "object"
              }
            },
            "required": [
              "currency",
              "units",
              "prices"
            ],
            "type": "object"
          },
          "provider": {
            "$ref": "#/$defs/provider"
          },
          "provider_idempotency_policy": {
            "additionalProperties": false,
            "properties": {
              "correlation_field": {
                "anyOf": [
                  {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "key_field": {
                "anyOf": [
                  {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "enum": [
                  "wait_and_query",
                  "retry_accepting_duplicate_risk",
                  "no_auto_retry"
                ]
              },
              "provider_key": {
                "type": "boolean"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "status_query": {
                "type": "boolean"
              }
            },
            "required": [
              "mode",
              "provider_key",
              "key_field",
              "correlation_field",
              "status_query",
              "source"
            ],
            "type": "object"
          },
          "sources": {
            "items": {
              "$ref": "#/$defs/source"
            },
            "type": "array"
          },
          "vectors": {
            "items": {
              "$ref": "#/$defs/vector"
            },
            "type": "array"
          }
        },
        "required": [
          "provider",
          "adapter_version",
          "channels",
          "evidence",
          "errors",
          "vectors"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "semantics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "$ref": "#/$defs/channel"
          },
          "decision_signals": {
            "items": {
              "$ref": "#/$defs/event_code"
            },
            "type": "array",
            "uniqueItems": true
          },
          "delivered": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "engagement": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sent": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "channel",
          "sent",
          "delivered",
          "engagement",
          "decision_signals",
          "note",
          "source"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "semantics",
    "providers"
  ],
  "type": "object"
}
