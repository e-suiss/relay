{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "region_defaults",
  "description": "The installation default time zone and locale of each data region. A tenant that an Access tenant.created event opens starts with the defaults of its region until Access carries the tenant's own (E-95). Each region appears at most once.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "regions"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "time_zone",
          "locale"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "tr",
              "eu",
              "us"
            ]
          },
          "time_zone": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+\\-]+)+$"
          },
          "locale": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        }
      }
    }
  }
}
