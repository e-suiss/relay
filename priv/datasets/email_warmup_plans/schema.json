{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_warmup_plans",
  "description": "Warm-up plans for new sending domains and IP addresses (CH-42). A plan is a list of steps; a step starts on its `from_day` (day 1 is the first sending day) and holds until the next step, and after the last step's `until_day` the plan is complete. A step caps the mail of a day and, per recipient domain, the mail of an hour; a recipient domain row overrides the hourly cap for that domain. Mail over the plan is deferred, never refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "plans"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "plans": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "applies_to",
          "until_day",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "applies_to": {
            "type": "string",
            "enum": [
              "domain",
              "ip"
            ]
          },
          "until_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_day",
                "daily_cap",
                "domain_hourly_cap"
              ],
              "properties": {
                "from_day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                "daily_cap": {
                  "type": "integer",
                  "minimum": 1
                },
                "domain_hourly_cap": {
                  "type": "integer",
                  "minimum": 1
                },
                "domains": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
