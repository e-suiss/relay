{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "country_time_zones",
  "description": "The IANA time zone of each ISO 3166-1 alpha-2 country that has exactly one zone in the IANA tzdata zone.tab, used as a time zone fallback from a profile country. Countries with more than one zone are absent and never map to a main zone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "tzdata",
    "zones"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "tzdata": {
      "type": "string",
      "pattern": "^[0-9]{4}[a-z]$"
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "country",
          "zone"
        ],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "zone": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+\\-]+)+$"
          }
        }
      }
    }
  }
}
