{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_bounce_codes",
  "description": "The mapping of e-mail bounce status codes (RFC 3463) to Relay bounce kinds (CH-39). A recipient's status is matched first against an exact code, then against the dialects, then against the longest prefix; a status that matches nothing is unknown (CH-8, CH-77). A dialect matches a permanent or missing status whose diagnostic contains its lowercase text; it corrects providers that write a generic status for a known case. Every row names its source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "codes",
    "prefixes",
    "dialects"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "kind",
          "source"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[245]\\.[0-9]{1,3}\\.[0-9]{1,3}$"
          },
          "kind": {
            "$ref": "#/$defs/kind"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "prefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prefix",
          "kind",
          "source"
        ],
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^[245](\\.[0-9]{1,3})?$"
          },
          "kind": {
            "$ref": "#/$defs/kind"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "dialects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contains",
          "kind",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "contains": {
            "type": "string",
            "minLength": 4,
            "maxLength": 200,
            "pattern": "^[^A-Z]+$"
          },
          "kind": {
            "$ref": "#/$defs/kind"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  },
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "hard",
        "soft",
        "sender_config",
        "policy",
        "content"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
