{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reconciliation",
  "description": "The periodic channel reconciliation (DS-22, DS-48, OP-42): which provider of a channel is reconciled and how. A `status` provider is asked about its open deliveries, accepted and neither delivered nor failed, once their age passes the channel's `min_age_s`, every `interval_s`, at most `per_round` deliveries per scope, channel and provider and oldest first. A `report` provider's event list is read once a day at `run_at` (UTC, HH:MM) for the previous UTC day. Times are multiples of the five-minute sweep.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_ref", "status", "report", "providers"],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_s", "per_round", "min_age_s"],
      "properties": {
        "interval_s": {
          "type": "integer",
          "minimum": 300,
          "maximum": 86400,
          "multipleOf": 300
        },
        "per_round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "min_age_s": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1209600
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_at"],
      "properties": {
        "run_at": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][05]$"
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "channel", "mode"],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "channel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "mode": {
            "enum": ["status", "report"]
          }
        }
      }
    }
  }
}
