{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "retention_periods",
  "description": "Retention period of each retention class by region and sector, compiled from Access Appendix C. The period runs from the creation of the record; a class without a row has no statutory retention.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "periods"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "sector",
          "retention_class",
          "days",
          "legal_basis",
          "source"
        ],
        "properties": {
          "region": {
            "enum": [
              "tr",
              "eu",
              "us"
            ]
          },
          "sector": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "retention_class": {
            "enum": [
              "recipient_profile",
              "notification_content",
              "delivery_record",
              "commercial_consent",
              "commercial_message",
              "preference",
              "audit",
              "traffic",
              "suppression",
              "dsr_log",
              "erasure_log"
            ]
          },
          "days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 36525
          },
          "legal_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
